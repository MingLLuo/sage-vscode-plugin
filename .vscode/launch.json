{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sage Plugin: Smoke Workspace",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension-core",
        "--skip-release-notes",
        "--skip-welcome",
        "--disable-workspace-trust",
        "${workspaceFolder}/examples/manual-smoke-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/extension-core/out/**/*.js"
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "Sage Plugin: Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension-core",
        "--skip-release-notes",
        "--skip-welcome",
        "--disable-workspace-trust",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/extension-core/out/**/*.js"
      ],
      "preLaunchTask": "build"
    }
  ]
}
