{
  "name": "sage-vscode-extension",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "sage-vscode",
  "license": "MIT",
  "icon": "resources/branding/icon.png",
  "galleryBanner": {
    "color": "#0b3438",
    "theme": "dark"
  },
  "preview": true,
  "qna": false,
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "sage",
    "sagemath",
    "mathematics",
    "language-server",
    "lsp",
    "cython"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Sage syntax remains available, but the language server, indexing, documentation workers, REPL, and run commands require workspace trust because they start local processes and can execute workspace code.",
      "restrictedConfigurations": [
        "sage.interpreter.path",
        "sage.interpreter.args",
        "sage.languageServer.rustPath",
        "sage.analysis.extraPaths",
        "sage.analysis.sourceRoots",
        "sage.analysis.enableRuntimeIntrospection",
        "sage.analysis.enablePyxParsing",
        "sage.analysis.enablePythonFiles",
        "sage.run.target",
        "sage.run.cleanupGeneratedPython"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Sage syntax remains available in virtual workspaces; the language server, indexing, documentation workers, REPL, and run commands require a local file workspace."
    }
  },
  "activationEvents": [
    "onLanguage:sagemath",
    "onLanguage:sagemath-cython",
    "onLanguage:python",
    "workspaceContains:**/*.sage",
    "workspaceContains:**/*.sage.py",
    "workspaceContains:**/*.pyx",
    "workspaceContains:**/*.pxd",
    "workspaceContains:**/*.pxi",
    "workspaceContains:**/*.spyx"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build",
    "test": "npm run build && node --test out/test/**/*.test.js",
    "test:extension-host": "cargo build --locked -p sage-ls && npm run build && node ./out/test-host/runTest.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "3.17.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "1.97.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.8.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "sagemath",
        "aliases": [
          "SageMath",
          "sage"
        ],
        "extensions": [
          ".sage"
        ],
        "configuration": "./resources/generated/syntax/language-configuration.json"
      },
      {
        "id": "sagemath-cython",
        "aliases": [
          "SageMath Cython",
          "sage-cython"
        ],
        "extensions": [
          ".pyx",
          ".pxd",
          ".pxi",
          ".spyx"
        ],
        "configuration": "./resources/generated/syntax/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sagemath",
        "scopeName": "source.sagemath",
        "path": "./resources/generated/syntax/syntaxes/sagemath.tmLanguage.json"
      },
      {
        "language": "sagemath-cython",
        "scopeName": "source.sagemath",
        "path": "./resources/generated/syntax/syntaxes/sagemath.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sagemath",
        "path": "./resources/generated/syntax/snippets/sagemath.json"
      },
      {
        "language": "sagemath-cython",
        "path": "./resources/generated/syntax/snippets/sagemath.json"
      }
    ],
    "commands": [
      {
        "command": "sage.openGettingStarted",
        "title": "%command.openGettingStarted.title%",
        "category": "Sage",
        "icon": "$(rocket)"
      },
      {
        "command": "sage.selectInterpreter",
        "title": "%command.selectInterpreter.title%",
        "category": "Sage",
        "icon": "$(gear)"
      },
      {
        "command": "sage.configureWorkspace",
        "title": "%command.configureWorkspace.title%",
        "category": "Sage",
        "icon": "$(tools)"
      },
      {
        "command": "sage.restartLanguageServer",
        "title": "%command.restartLanguageServer.title%",
        "category": "Sage",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sage.runCurrentFile",
        "title": "%command.runCurrentFile.title%",
        "category": "Sage",
        "icon": "$(play)",
        "enablement": "sage.workspaceRuntimeAvailable && (editorLangId == sagemath || (editorLangId == python && config.sage.analysis.enablePythonFiles)) && resourceScheme == file"
      },
      {
        "command": "sage.runSelection",
        "title": "%command.runSelection.title%",
        "category": "Sage",
        "icon": "$(selection)",
        "enablement": "sage.workspaceRuntimeAvailable && (editorLangId == sagemath || (editorLangId == python && config.sage.analysis.enablePythonFiles))"
      },
      {
        "command": "sage.runCurrentCell",
        "title": "%command.runCurrentCell.title%",
        "category": "Sage",
        "icon": "$(run)",
        "enablement": "sage.workspaceRuntimeAvailable && (editorLangId == sagemath || (editorLangId == python && config.sage.analysis.enablePythonFiles))"
      },
      {
        "command": "sage.startRepl",
        "title": "%command.startRepl.title%",
        "category": "Sage",
        "icon": "$(terminal)"
      },
      {
        "command": "sage.showDocumentation",
        "title": "%command.showDocumentation.title%",
        "category": "Sage",
        "icon": "$(book)",
        "enablement": "sage.workspaceRuntimeAvailable"
      },
      {
        "command": "sage.findReferences",
        "title": "%command.findReferences.title%",
        "category": "Sage",
        "icon": "$(references)",
        "enablement": "sage.workspaceRuntimeAvailable"
      },
      {
        "command": "sage.showEnvironmentDetails",
        "title": "%command.showEnvironmentDetails.title%",
        "category": "Sage",
        "icon": "$(info)"
      },
      {
        "command": "sage.showIndexStatus",
        "title": "%command.showIndexStatus.title%",
        "category": "Sage",
        "icon": "$(database)"
      },
      {
        "command": "sage.showDocsStatus",
        "title": "%command.showDocsStatus.title%",
        "category": "Sage",
        "icon": "$(book)"
      },
      {
        "command": "sage.copySupportBundle",
        "title": "%command.copySupportBundle.title%",
        "category": "Sage",
        "icon": "$(clippy)"
      },
      {
        "command": "sage.runUxSelfCheck",
        "title": "%command.runUxSelfCheck.title%",
        "category": "Sage",
        "icon": "$(checklist)",
        "enablement": "sage.workspaceRuntimeAvailable"
      },
      {
        "command": "sage.buildDatabase",
        "title": "%command.buildDatabase.title%",
        "category": "Sage",
        "icon": "$(database)",
        "enablement": "sage.workspaceRuntimeAvailable"
      },
      {
        "command": "sage.rebuildIndex",
        "title": "%command.rebuildIndex.title%",
        "category": "Sage",
        "icon": "$(refresh)"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "installSage",
            "title": "%walkthrough.gettingStarted.installSage.title%",
            "description": "%walkthrough.gettingStarted.installSage.description%",
            "media": {
              "markdown": "%walkthrough.gettingStarted.installSage.media%"
            },
            "completionEvents": [
              "onCommand:sage.selectInterpreter",
              "onLink:https://doc.sagemath.org/html/en/installation/index.html"
            ]
          },
          {
            "id": "runFirstFile",
            "title": "%walkthrough.gettingStarted.runFirstFile.title%",
            "description": "%walkthrough.gettingStarted.runFirstFile.description%",
            "media": {
              "markdown": "%walkthrough.gettingStarted.runFirstFile.media%"
            },
            "completionEvents": [
              "onCommand:sage.runCurrentFile"
            ]
          },
          {
            "id": "editAndExplore",
            "title": "%walkthrough.gettingStarted.editAndExplore.title%",
            "description": "%walkthrough.gettingStarted.editAndExplore.description%",
            "media": {
              "markdown": "%walkthrough.gettingStarted.editAndExplore.media%"
            },
            "completionEvents": [
              "onCommand:sage.runSelection",
              "onCommand:sage.runCurrentCell",
              "onCommand:sage.startRepl",
              "onCommand:sage.showDocumentation"
            ]
          },
          {
            "id": "configureWorkspace",
            "title": "%walkthrough.gettingStarted.configureWorkspace.title%",
            "description": "%walkthrough.gettingStarted.configureWorkspace.description%",
            "media": {
              "markdown": "%walkthrough.gettingStarted.configureWorkspace.media%"
            },
            "completionEvents": [
              "onCommand:sage.configureWorkspace"
            ]
          },
          {
            "id": "troubleshoot",
            "title": "%walkthrough.gettingStarted.troubleshoot.title%",
            "description": "%walkthrough.gettingStarted.troubleshoot.description%",
            "media": {
              "markdown": "%walkthrough.gettingStarted.troubleshoot.media%"
            },
            "completionEvents": [
              "onCommand:sage.showEnvironmentDetails",
              "onCommand:sage.copySupportBundle",
              "onCommand:sage.restartLanguageServer"
            ]
          }
        ]
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "sage.runCurrentFile",
          "when": "sage.workspaceRuntimeAvailable && (resourceLangId == sagemath || (resourceLangId == python && config.sage.analysis.enablePythonFiles)) && resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "sage.runSelection",
          "when": "sage.workspaceRuntimeAvailable && (resourceLangId == sagemath || (resourceLangId == python && config.sage.analysis.enablePythonFiles))",
          "group": "1_run@10"
        },
        {
          "command": "sage.runCurrentCell",
          "when": "sage.workspaceRuntimeAvailable && (resourceLangId == sagemath || (resourceLangId == python && config.sage.analysis.enablePythonFiles))",
          "group": "1_run@20"
        },
        {
          "command": "sage.showDocumentation",
          "when": "sage.workspaceRuntimeAvailable && (resourceLangId == sagemath || resourceLangId == sagemath-cython || (resourceLangId == python && config.sage.analysis.enablePythonFiles))",
          "group": "2_sage@10"
        }
      ],
      "commandPalette": [
        {
          "command": "sage.runCurrentFile",
          "when": "sage.workspaceRuntimeAvailable && (editorLangId == sagemath || (editorLangId == python && config.sage.analysis.enablePythonFiles)) && resourceScheme == file"
        },
        {
          "command": "sage.runSelection",
          "when": "sage.workspaceRuntimeAvailable && (editorLangId == sagemath || (editorLangId == python && config.sage.analysis.enablePythonFiles))"
        },
        {
          "command": "sage.runCurrentCell",
          "when": "sage.workspaceRuntimeAvailable && (editorLangId == sagemath || (editorLangId == python && config.sage.analysis.enablePythonFiles))"
        },
        {
          "command": "sage.showDocumentation",
          "when": "sage.workspaceRuntimeAvailable"
        },
        {
          "command": "sage.findReferences",
          "when": "sage.workspaceRuntimeAvailable"
        },
        {
          "command": "sage.runUxSelfCheck",
          "when": "false"
        },
        {
          "command": "sage.buildDatabase",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "sage.interpreter.path": {
          "type": "string",
          "default": "sage",
          "scope": "resource",
          "markdownDescription": "%config.interpreter.path.description%"
        },
        "sage.interpreter.args": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%config.interpreter.args.description%"
        },
        "sage.languageServer.rustPath": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "%config.languageServer.rustPath.description%"
        },
        "sage.analysis.mode": {
          "type": "string",
          "default": "default",
          "scope": "resource",
          "enum": [
            "light",
            "default",
            "full"
          ],
          "markdownDescription": "%config.analysis.mode.description%",
          "enumDescriptions": [
            "%config.analysis.mode.enum.light%",
            "%config.analysis.mode.enum.default%",
            "%config.analysis.mode.enum.full%"
          ]
        },
        "sage.analysis.extraPaths": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%config.analysis.extraPaths.description%"
        },
        "sage.analysis.sourceRoots": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%config.analysis.sourceRoots.description%"
        },
        "sage.analysis.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.analysis.enableDiagnostics.description%"
        },
        "sage.analysis.enableRuntimeIntrospection": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.analysis.enableRuntimeIntrospection.description%"
        },
        "sage.analysis.enablePyxParsing": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.analysis.enablePyxParsing.description%"
        },
        "sage.analysis.enablePythonFiles": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.analysis.enablePythonFiles.description%"
        },
        "sage.indexing.exclude": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/__pycache__/**",
            "**/.venv/**",
            "**/build/**"
          ],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%config.indexing.exclude.description%"
        },
        "sage.docs.preferredSource": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "workspace",
            "runtime",
            "reference"
          ],
          "markdownDescription": "%config.docs.preferredSource.description%",
          "enumDescriptions": [
            "%config.docs.preferredSource.enum.auto%",
            "%config.docs.preferredSource.enum.workspace%",
            "%config.docs.preferredSource.enum.runtime%",
            "%config.docs.preferredSource.enum.reference%"
          ]
        },
        "sage.docs.showOnHover": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.docs.showOnHover.description%"
        },
        "sage.logging.level": {
          "type": "string",
          "default": "info",
          "scope": "resource",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "markdownDescription": "%config.logging.level.description%",
          "enumDescriptions": [
            "%config.logging.level.enum.error%",
            "%config.logging.level.enum.warn%",
            "%config.logging.level.enum.info%",
            "%config.logging.level.enum.debug%"
          ]
        },
        "sage.run.target": {
          "type": "string",
          "default": "terminal",
          "scope": "resource",
          "enum": [
            "terminal",
            "repl"
          ],
          "markdownDescription": "%config.run.target.description%",
          "enumDescriptions": [
            "%config.run.target.enum.terminal%",
            "%config.run.target.enum.repl%"
          ]
        },
        "sage.run.showCellCodeLens": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.run.showCellCodeLens.description%"
        },
        "sage.run.cleanupGeneratedPython": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.run.cleanupGeneratedPython.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "sage.runSelection",
        "key": "shift+enter",
        "when": "editorTextFocus && sage.workspaceRuntimeAvailable && (editorLangId == sagemath || editorLangId == sagemath-cython || (editorLangId == python && config.sage.analysis.enablePythonFiles)) && editorHasSelection"
      },
      {
        "command": "sage.runCurrentCell",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && sage.workspaceRuntimeAvailable && (editorLangId == sagemath || editorLangId == sagemath-cython || (editorLangId == python && config.sage.analysis.enablePythonFiles))"
      }
    ]
  },
  "l10n": "./l10n"
}
