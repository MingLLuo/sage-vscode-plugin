{
  "name": "SageMath",
  "scopeName": "source.sagemath",
  "fileTypes": ["sage", "pyx", "pxd", "pxi", "spyx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#triple-quoted-strings" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#sage-runtime-helpers" },
    { "include": "#preparse-assignment" },
    { "include": "#factory-assignment" },
    { "include": "#sage-variable-assignment" },
    { "include": "#sage-keyword-arguments" },
    { "include": "#cython-declarations" },
    { "include": "#definitions" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#sage-domains" },
    { "include": "#sage-namespaces" },
    { "include": "#sage-constructors" },
    { "include": "#sage-geometry" },
    { "include": "#sage-modules" },
    { "include": "#sage-linear-algebra" },
    { "include": "#sage-symbolic" },
    { "include": "#sage-plotting" },
    { "include": "#sage-number-theory" },
    { "include": "#sage-combinatorics" },
    { "include": "#sage-graph-theory" },
    { "include": "#sage-crypto" },
    { "include": "#sage-call-sites" },
    { "include": "#cython-support" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sagemath",
          "match": "#.*$"
        }
      ]
    },
    "triple-quoted-strings": {
      "patterns": [
        {
          "name": "string.quoted.multi.double.sagemath",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.multi.single.sagemath",
          "begin": "'''",
          "end": "'''"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sagemath",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sagemath",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.sagemath",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sagemath",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "support.function.decorator.interact.sagemath",
          "match": "^\\s*(@(?:interact|interact_manual))\\b"
        },
        {
          "name": "storage.type.decorator.cache.sagemath",
          "match": "^\\s*(@(?:cached_method|cached_function|cached_in_parent_method|cached_property|lazy_attribute))\\b"
        },
        {
          "name": "support.function.decorator.cython.sagemath",
          "match": "^\\s*(@cython\\.[A-Za-z_][A-Za-z0-9_]*)\\b"
        },
        {
          "name": "meta.annotation.sagemath",
          "match": "^\\s*(@[A-Za-z_][A-Za-z0-9_\\.]*)"
        }
      ]
    },
    "sage-runtime-helpers": {
      "patterns": [
        {
          "name": "support.function.runtime-helper.sagemath",
          "match": "\\b(lazy_import|lazy_attribute|cached_method|cached_function|cached_in_parent_method|cached_property|UniqueFactory|ClasscallMetaclass|abstract_method)\\b"
        },
        {
          "name": "support.function.interact-control.sagemath",
          "match": "\\b(input_box|slider|range_slider|selector|checkbox|color_selector|text_control)\\b"
        }
      ]
    },
    "preparse-assignment": {
      "patterns": [
        {
          "name": "meta.assignment.preparse.sagemath",
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(\\.)(\\<)",
          "beginCaptures": {
            "1": { "name": "variable.other.readwrite.sagemath" },
            "2": { "name": "punctuation.accessor.dot.sagemath" },
            "3": { "name": "punctuation.definition.generator.begin.sagemath" }
          },
          "end": "(\\>)(\\s*=)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generator.end.sagemath" },
            "2": { "name": "keyword.operator.assignment.sagemath" }
          },
          "patterns": [
            {
              "name": "variable.parameter.preparse.generator.sagemath",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.generator.sagemath",
              "match": ","
            }
          ]
        }
      ]
    },
    "factory-assignment": {
      "patterns": [
        {
          "name": "meta.assignment.factory.sagemath",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(\\s*=\\s*)([A-Z][A-Za-z0-9_]*Factory)(\\s*\\()",
          "captures": {
            "1": { "name": "variable.other.constant.sagemath" },
            "2": { "name": "keyword.operator.assignment.sagemath" },
            "3": { "name": "entity.name.type.factory.sagemath" },
            "4": { "name": "punctuation.definition.parameters.begin.sagemath" }
          }
        }
      ]
    },
    "sage-variable-assignment": {
      "patterns": [
        {
          "name": "meta.assignment.variable.sagemath",
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*)(?:(:)(\\s*[^=\\n]+?)\\s*)?(=)(?!=)",
          "captures": {
            "2": { "name": "variable.other.assignment.sagemath" },
            "4": { "name": "punctuation.separator.annotation.sagemath" },
            "5": { "name": "storage.type.annotation.sagemath" },
            "6": { "name": "keyword.operator.assignment.sagemath" }
          }
        }
      ]
    },
    "sage-keyword-arguments": {
      "patterns": [
        {
          "name": "meta.argument.keyword.sagemath",
          "match": "([\\(,]\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*=)(?!=)",
          "captures": {
            "1": { "name": "punctuation.separator.argument.sagemath" },
            "2": { "name": "variable.parameter.keyword.sagemath" },
            "3": { "name": "keyword.operator.assignment.sagemath" }
          }
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "name": "meta.class.definition.sagemath",
          "match": "^(\\s*)(class|cdef\\s+class|cpdef\\s+class)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "2": { "name": "keyword.declaration.class.sagemath" },
            "4": { "name": "entity.name.type.class.sagemath" }
          }
        },
        {
          "name": "meta.function.definition.sagemath",
          "match": "^(\\s*)(?:async\\s+def|def|cpdef|cdef)(?:\\s+(?:inline|api|public|readonly|nogil|gil|except|const|unsigned|signed|long|short|char|int|float|double|void|object|bint|size_t|Py_ssize_t|[A-Za-z_][A-Za-z0-9_\\.\\*\\[\\]]*))*\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*\\()",
          "captures": {
            "2": { "name": "entity.name.function.sagemath" },
            "3": { "name": "punctuation.definition.parameters.begin.sagemath" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "keyword.control.import.sagemath",
          "match": "\\b(from|import|cimport|include|as)\\b"
        }
      ]
    },
    "cython-declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.cython.sagemath",
          "match": "\\b(cdef|cpdef|ctypedef)\\b"
        },
        {
          "name": "keyword.control.import.cython.sagemath",
          "match": "\\b(cimport)\\b"
        },
        {
          "name": "meta.include.cython.sagemath",
          "match": "^(\\s*)(include)(\\s+)([\"'][^\"']+[\"'])",
          "captures": {
            "2": { "name": "keyword.control.include.cython.sagemath" },
            "4": { "name": "string.quoted.include.cython.sagemath" }
          }
        },
        {
          "name": "storage.modifier.cython.sagemath",
          "match": "\\b(nogil|gil|except|public|readonly|api|extern|inline|const|unsigned|signed)\\b"
        },
        {
          "name": "meta.typed-variable.cython.sagemath",
          "match": "\\b(bint|char|short|int|long|float|double|void|object|size_t|Py_ssize_t|mpz_t|mpq_t|mpfr_t|cppclass|[A-Za-z_][A-Za-z0-9_\\.]*)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:=|,|\\)|:|$))",
          "captures": {
            "1": { "name": "storage.type.cython.sagemath" },
            "3": { "name": "variable.other.typed.cython.sagemath" }
          }
        },
        {
          "name": "meta.return-type.cython.sagemath",
          "match": "\\b(cpdef|cdef)(?:\\s+(?:inline|api|public|readonly|nogil|gil|except|const|unsigned|signed))*\\s+([A-Za-z_][A-Za-z0-9_\\.\\*\\[\\]]+)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s*\\()",
          "captures": {
            "1": { "name": "keyword.declaration.cython.sagemath" },
            "2": { "name": "storage.type.cython.sagemath" },
            "4": { "name": "entity.name.function.cython.sagemath" },
            "5": { "name": "punctuation.definition.parameters.begin.sagemath" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.sagemath",
          "match": "\\b(def|class|return|yield|raise|break|continue|pass|if|elif|else|for|while|try|except|finally|with|lambda|and|or|not|in|is|async|await|assert|del|global|nonlocal|cdef|cpdef|cimport|ctypedef|nogil|gil|extern|public|readonly|api|property)\\b"
        }
      ]
    },
    "sage-domains": {
      "patterns": [
        {
          "name": "support.type.ring.sagemath",
          "match": "\\b(ZZ|QQ|RR|CC|SR|GF|QQbar|ZZbar|AA|RIF|CIF|RLF|CLF|CDF|RDF|IF|Integers|Rationals|ComplexField|RealField|ComplexIntervalField|RealIntervalField|ComplexDoubleField|RealDoubleField|FiniteField|IntegerModRing|Zmod|Qp|Zp|PolynomialRing|LaurentPolynomialRing|OrePolynomialRing|PowerSeriesRing|LazyPowerSeriesRing|UniversalCyclotomicField)\\b"
        },
        {
          "name": "constant.language.sagemath",
          "match": "\\b(pi|e|I|oo|Infinity|NaN|unsigned_infinity|minus_infinity)\\b"
        }
      ]
    },
    "sage-namespaces": {
      "patterns": [
        {
          "name": "entity.name.namespace.sagemath",
          "match": "\\b(graphs|codes|crystals|designs|manifolds|polytopes|posets|root_system|toric_varieties|simplicial_complexes|matroids|mq|interacts|plot3d)\\b"
        }
      ]
    },
    "sage-constructors": {
      "patterns": [
        {
          "name": "support.class.constructor.sagemath",
          "match": "\\b(PolynomialRing|PowerSeriesRing|LaurentSeriesRing|FractionField|FunctionField|QuadraticField|CyclotomicField|NumberField|OrePolynomialRing|MatrixSpace|EllipticCurve|ProjectiveSpace|AffineSpace|Graph|DiGraph|FreeModule|VectorSpace|SimplicialComplex|FilteredSimplicialComplex|ChowGroup|FreeAbelianMonoid|Parent|Set|Sequence|RootSystem|WeylGroup|CartanType|PermutationGroup|DirichletGroup|ModularSymbols|CuspForms)\\b"
        }
      ]
    },
    "sage-geometry": {
      "patterns": [
        {
          "name": "support.class.geometry.sagemath",
          "match": "\\b(ToricVariety|Cone|Fan|Polyhedron|LatticePolytope|ToricPlotter|CPRFanoToricVariety)\\b"
        }
      ]
    },
    "sage-modules": {
      "patterns": [
        {
          "name": "support.class.modules.sagemath",
          "match": "\\b(FreeModule|VectorSpace|Module|CombinatorialFreeModule|TensorProduct|ExteriorAlgebra|SymmetricGroupAlgebra)\\b"
        }
      ]
    },
    "sage-linear-algebra": {
      "patterns": [
        {
          "name": "support.function.linear-algebra.sagemath",
          "match": "\\b(matrix|vector|identity_matrix|diagonal_matrix|block_matrix|random_matrix)\\b"
        }
      ]
    },
    "sage-symbolic": {
      "patterns": [
        {
          "name": "support.function.symbolic.sagemath",
          "match": "\\b(var|function|assume|forget|factor|factorial|expand|simplify|integrate|diff|derivative|limit|solve|sqrt|sin|cos|tan|exp|log|floor|ceil)\\b"
        }
      ]
    },
    "sage-plotting": {
      "patterns": [
        {
          "name": "support.function.plotting.sagemath",
          "match": "\\b(plot|parametric_plot|implicit_plot|list_plot|line|point|circle|polygon|density_plot|contour_plot|region_plot|text|text3d|show)\\b"
        }
      ]
    },
    "sage-number-theory": {
      "patterns": [
        {
          "name": "support.function.number-theory.sagemath",
          "match": "\\b(ideal|gcd|lcm|xgcd|prime_divisors|divisors|sigma|euler_phi|next_prime|previous_prime|is_prime|is_square|valuation|cyclotomic_polynomial)\\b"
        }
      ]
    },
    "sage-combinatorics": {
      "patterns": [
        {
          "name": "support.class.combinatorics.sagemath",
          "match": "\\b(Partitions|Permutations|SymmetricGroup|Compositions|Combinations|Subsets|cartesian_product)\\b"
        }
      ]
    },
    "sage-graph-theory": {
      "patterns": [
        {
          "name": "support.function.graph-theory.sagemath",
          "match": "\\b(Graph|DiGraph|PetersenGraph|CompleteGraph|CycleGraph|PathGraph)\\b"
        }
      ]
    },
    "sage-crypto": {
      "patterns": [
        {
          "name": "support.class.crypto.sagemath",
          "match": "\\b(BooleanFunction|SBox)\\b"
        }
      ]
    },
    "sage-call-sites": {
      "patterns": [
        {
          "name": "meta.method-call.sagemath",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.sagemath" },
            "2": { "name": "support.function.method.sagemath" }
          }
        },
        {
          "name": "support.function.call.sagemath",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "cython-support": {
      "patterns": [
        {
          "name": "storage.type.cython.sagemath",
          "match": "\\b(bint|char|short|int|long|float|double|void|size_t|Py_ssize_t|mpz_t|mpq_t|mpfr_t|cppclass)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.sagemath",
          "match": "(\\*\\*|\\^|//|\\+|-|/|%|\\*=|/=|//=|%=|\\+=|-=)"
        },
        {
          "name": "keyword.operator.range.sagemath",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.sagemath",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.sagemath",
          "match": "(:=|=)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.sagemath",
          "match": "\\b(True|False|None|NULL)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sagemath",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?\\d[\\d_]*)?)\\b"
        }
      ]
    }
  }
}
